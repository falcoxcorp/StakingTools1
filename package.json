{
  "name": "@socn/pipi_tools",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "author": "Silvio Carrandi Noa",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix --force",
    "security:check": "npm run security:audit && npm run lint",
    "security:update": "npm update && npm run security:check",
    "test:security": "npm run lint && npm run build",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "backup:create": "git checkout -b backup-$(date +%Y%m%d-%H%M%S) && git add . && git commit -m 'Backup before updates'"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@fontsource/poppins": "^5.0.8",
    "@hookform/resolvers": "^3.3.4",
    "@mui/icons-material": "^5.15.15",
    "@mui/lab": "^5.0.0-alpha.170",
    "@mui/material": "^5.15.15",
    "@mui/x-data-grid": "^6.19.8",
    "@mui/x-date-pickers": "^6.19.8",
    "@tanstack/react-query": "^4.36.1",
    "@tanstack/react-query-devtools": "^4.36.1",
    "@types/numeral": "^2.0.5",
    "@usedapp/coingecko": "^1.1.16",
    "@usedapp/core": "^1.2.13",
    "axios": "^1.6.8",
    "bignumber": "^1.1.0",
    "classnames": "^2.5.1",
    "clipboard-copy": "^4.0.1",
    "date-fns": "^2.30.0",
    "ethers": "5.7.2",
    "evm-bn": "^1.1.2",
    "i18next": "^23.11.5",
    "lodash": "^4.17.21",
    "numeral": "^2.0.6",
    "react": "^18.2.0",
    "react-cookie": "^6.1.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.4",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^14.1.2",
    "react-router-dom": "^6.23.1",
    "react-social-icons": "^6.4.0",
    "web3": "^4.8.0",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.4",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "typescript": "^5.4.5",
    "vite": "^5.2.11"
  },
  "overrides": {
    "ethers": "5.7.2",
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/providers": "^5.7.2",
    "@ethersproject/contracts": "^5.7.0"
  },
  "resolutions": {
    "ethers": "5.7.2",
    "@ethersproject/abi": "^5.7.0",
    "@ethersproject/providers": "^5.7.2",
    "@ethersproject/contracts": "^5.7.0"
  }
}