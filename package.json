{
  "name": "@socn/pipi_tools",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "author": "Silvio Carrandi Noa",
  "scripts": {
    "dev": "npx vite",
    "build": "tsc && vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "npx vite preview",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix --force",
    "security:check": "npm run security:audit && npm run lint",
    "security:update": "npm update && npm run security:check",
    "test:security": "npm run lint && npm run build",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "backup:create": "git checkout -b backup-$(date +%Y%m%d-%H%M%S) && git add . && git commit -m 'Backup before updates'"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@fontsource/poppins": "^5.1.0",
    "@hookform/resolvers": "^3.9.1",
    "@mui/icons-material": "^6.1.6",
    "@mui/lab": "^6.0.0-beta.12",
    "@mui/material": "^6.1.6",
    "@mui/x-data-grid": "^7.22.2",
    "@mui/x-date-pickers": "^7.22.2",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.1.0",
    "@pancakeswap/uikit": "^0.77.0",
    "@tanstack/react-query": "^5.59.20",
    "@types/numeral": "^2.0.5",
    "@usedapp/coingecko": "^1.1.16",
    "@usedapp/core": "^1.2.13",
    "add": "^2.0.6",
    "axios": "^1.7.9",
    "bignumber": "^1.1.0",
    "classnames": "^2.3.2",
    "clipboard-copy": "^4.0.1",
    "date-fns": "^2.30.0",
    "ethers": "^5.7.2",
    "evm-bn": "^1.1.2",
    "i18next": "^23.16.4",
    "lodash": "^4.17.21",
    "numeral": "^2.0.6",
    "particles-bg": "^2.5.5",
    "react": "^18.3.1",
    "react-cookie": "^6.1.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.0",
    "react-hot-toast": "^2.4.1",
    "react-i18next": "^15.1.2",
    "react-router-dom": "^6.28.0",
    "react-social-icons": "^6.4.0",
    "web3": "^4.15.0",
    "yarn": "^1.22.19",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.59.20",
    "@types/lodash": "^4.17.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  }
}
